# SubStream Provider Configuration

# Tidal subscriber session token(s) (for full HiFi/Master FLAC without mirror restrictions)
# Supports single token or multiple accounts separated by commas (automatic round-robin & failover)
TIDAL_TOKEN="token1,token2,token3"
# Or: TIDAL_TOKENS="token1,token2,token3"

# Deezer ARL cookie (for full 16-bit FLAC)
DEEZER_ARL=""
# Deezer Generic Stream Filter activation token (optional: enables direct native stream decryption)
DEEZER_STREAM_FILTER=""

# Qobuz user auth token (for full Hi-Res FLAC up to 24-bit / 192kHz)
QOBUZ_TOKEN=""
# Optional custom Qobuz App ID and Secret (if omitted, default app pair will be used)
QOBUZ_APP_ID=""
QOBUZ_APP_SECRET=""

# Spotify Widevine configuration (for native decrypted AAC 128kbps Free / 256kbps Premium)
SPOTIFY_SP_DC=""
SPOTIFY_WVD_PATH="spotify.wvd"

# Deployment Configuration (used by deploy.sh)
DEPLOY_SERVER="127.0.0.1"
DEPLOY_PORT="22"
DEPLOY_USER="user"
DEPLOY_PATH="/opt/substream"

