<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M495.9 166.6c3.2 8.7 .5 18.4-6.4 24.6l-43.3 39.4c1.1 8.3 1.7 16.8 1.7 25.4s-.6 17.1-1.7 25.4l43.3 39.4c6.9 6.2 9.6 15.9 6.4 24.6c-4.4 11.9-9.7 23.3-15.8 34.3l-4.7 8.1c-6.6 11-14 21.4-22.1 31.2c-5.9 7.2-15.7 9.6-24.5 6.8l-55.7-17.7c-13.4 10.3-28.2 18.9-44 25.4l-12.5 57.1c-2 9.1-9 16.3-18.2 17.8c-13.8 2.3-28 3.5-42.5 3.5s-28.7-1.2-42.5-3.5c-9.2-1.5-16.2-8.7-18.2-17.8l-12.5-57.1c-15.8-6.5-30.6-15.1-44-25.4l-55.6 17.8c-8.8 2.8-18.6 .3-24.5-6.8c-8.1-9.8-15.5-20.2-22.1-31.2l-4.7-8.1c-6.1-11-11.4-22.4-15.8-34.3c-3.2-8.7-.5-18.4 6.4-24.6l43.3-39.4c-1.1-8.4-1.7-16.9-1.7-25.5s.6-17.1 1.7-25.4l-43.3-39.4c-6.9-6.2-9.6-15.9-6.4-24.6c4.4-11.9 9.7-23.3 15.8-34.3l4.7-8.1c6.6-11 14-21.4 22.1-31.2c5.9-7.2 15.7-9.6 24.5-6.8l55.7 17.7c13.4-10.3 28.2-18.9 44-25.4l12.5-57.1c2-9.1 9-16.3 18.2-17.8C227.3 1.2 241.5 0 256 0s28.7 1.2 42.5 3.5c9.2 1.5 16.2 8.7 18.2 17.8l12.5 57.1c15.8 6.5 30.6 15.1 44 25.4l55.7-17.7c8.8-2.8 18.6-.3 24.5 6.8c8.1 9.8 15.5 20.2 22.1 31.2l4.7 8.1c6.1 11 11.4 22.4 15.8 34.3zM256 336a80 80 0 1 0 0-160 80 80 0 1 0 0 160z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">server settings</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">configure global server settings</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <form class="flex flex-col gap-2 items-end" action="{{ path "/admin/settings_do" }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <label for="auto_register" class="text-sm text-gray-700">auto-register new users</label>
            <select name="auto_register" id="auto_register" style="width: 100%;">
                <option value="false"{{ if not .AutoRegister }} selected{{ end }}>disabled - only existing users can log in</option>
                <option value="true"{{ if .AutoRegister }} selected{{ end }}>enabled - new users created automatically on first login</option>
            </select>
            <hr class="border-gray-300/50 my-2 w-full">
            <label for="proxy_streams" class="text-sm text-gray-700">proxify audio streams</label>
            <select name="proxy_streams" id="proxy_streams" style="width: 100%;">
                <option value="false"{{ if not .ProxyStreams }} selected{{ end }}>disabled - redirect clients directly to tidal CDN (better performance)</option>
                <option value="true"{{ if .ProxyStreams }} selected{{ end }}>enabled - proxy streams through substream (avoids CORS issues)</option>
            </select>
            <hr class="border-gray-300/50 my-2 w-full">
            <label for="current_password" class="text-sm text-gray-700 font-semibold">current password (required for security)</label>
            <input type="password" name="current_password" id="current_password" placeholder="enter your password to confirm changes" required style="width: 100%;">
            <input type="submit" value="save settings">
        </form>
    </div>
</div>

{{ template "foot" . }}
