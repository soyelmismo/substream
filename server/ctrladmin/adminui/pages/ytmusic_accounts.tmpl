{{ template "head" . }}
{{ template "nav" . }}

<div class="flex flex-col gap-8">
    <div class="flex flex-col gap-4 text-right">
        <h1 class="text-3xl font-bold text-gray-900">youtube music accounts</h1>
        <p class="text-gray-500">manage youtube music session cookies with automatic fallback to anonymous free streaming</p>
    </div>

    <!-- Fallback Notice Banner -->
    <div class="p-4 border shadow-sm bg-emerald-100/60 border-emerald-500/30 flex items-center gap-x-3 w-full">
        <span class="text-emerald-700 w-6">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"/></svg>
        </span>
        <div class="text-xs text-emerald-900">
            <strong>Fallback a Gratuito Automático: Activo ✅</strong> — Si tus cookies expiran, rotan o no poseen suscripción Premium, Substream conmuta instantáneamente al motor anónimo nativo (<code class="bg-emerald-200/60 px-1 py-0.5 rounded font-mono">android_music / Opus 160k</code>) en &lt; 1 segundo sin interrumpir nunca tu música.
        </div>
    </div>

    <!-- Active Accounts Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </span>
            <span class="text-gray-900 font-bold">configured accounts</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">active youtube music accounts for personalized streams and recommendations</div>
        <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
            <div class="flex flex-col divide-y divide-gray-200">
                {{ range .YTMusicAccounts }}
                <div class="flex items-center justify-between py-3">
                    <div class="flex items-center gap-2">
                        <form action="{{ path "/admin/ytmusic_delete_account_do" }}" method="POST" onsubmit="return confirm('remove this account?')">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="submit" value="delete" class="text-rose-600 hover:text-rose-700 cursor-pointer text-xs font-bold px-1.5 py-1">
                        </form>
                        <form action="{{ path "/admin/ytmusic_toggle_account_do" }}" method="POST">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="hidden" name="active" value="{{ if .IsActive }}false{{ else }}true{{ end }}">
                            <input type="submit" value="{{ if .IsActive }}disable{{ else }}enable{{ end }}" class="text-gray-600 hover:text-gray-800 cursor-pointer text-xs font-bold px-1.5 py-1 bg-gray-100 hover:bg-gray-200 rounded">
                        </form>
                    </div>
                    <div class="flex items-center gap-4">
                        {{ if .IsActive }}
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">active</span>
                        {{ else }}
                            <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded">inactive</span>
                        {{ end }}
                        <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded" title="Audio streaming with silent free fallback">Audio (160k Opus / Free Fallback)</span>
                        <div class="flex flex-col items-end">
                            <span class="font-bold text-gray-900">{{ .Name }}</span>
                            <span class="text-[10px] text-gray-400">added {{ dateHuman .CreatedAt }}</span>
                        </div>
                    </div>
                </div>
                {{ else }}
                <div class="py-10 text-center text-gray-400 font-medium italic">
                    no youtube music accounts configured. running in anonymous free mode. add an account below.
                </div>
                {{ end }}
            </div>
        </div>
    </div>

    <!-- Add Account via Cookies Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </span>
            <span class="text-gray-900 font-bold">add youtube music account</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">
            paste cookies from your browser. supports JSON format (exported from Cookie-Editor or EditThisCookie), Netscape cookies.txt, or raw Cookie header.
        </div>
        <form action="{{ path "/admin/ytmusic_add_account_do" }}" method="POST" class="mt-4 max-w-[700px] ml-auto space-y-4 text-right">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <div class="flex flex-col gap-1 items-end">
                <label for="acc_name" class="text-xs font-bold text-gray-700">account name</label>
                <input id="acc_name" type="text" name="name" placeholder="e.g. Mi Cuenta YT Music" class="w-full max-w-[400px] border border-gray-300 px-3 py-2 text-sm rounded bg-white text-right">
            </div>
            <div class="flex flex-col gap-1 items-end">
                <label for="cookie_data" class="text-xs font-bold text-gray-700">cookies (JSON, Netscape, or Header)</label>
                <textarea id="cookie_data" name="cookie_data" rows="8" placeholder="[ { &quot;name&quot;: &quot;__Secure-3PSID&quot;, &quot;value&quot;: &quot;...&quot; }, ... ]" class="w-full border border-gray-300 p-3 font-mono text-xs rounded bg-white text-left" required></textarea>
            </div>
            <div>
                <input type="submit" value="add account" class="bg-gray-900 hover:bg-black text-white font-bold px-6 py-2 rounded cursor-pointer text-sm transition-colors shadow">
            </div>
        </form>
    </div>
</div>

{{ template "foot" . }}
