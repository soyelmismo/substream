{{ template "head" . }}

<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512H418.3c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304H178.3z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">login</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">if you are logging in as an admin, the default credentials can be found in the readme</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <form class="flex flex-col md:flex-row gap-2 items-end" action="{{ path "/admin/login_do" }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <input class="text-center" type="text" id="username" name="username" placeholder="username">
            <input class="text-center" type="password" id="password" name="password" placeholder="password">
            <input type="submit" value="login">
        </form>
    </div>
</div>

{{ template "foot" . }}
