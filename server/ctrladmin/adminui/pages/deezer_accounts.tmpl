{{ template "head" . }}
{{ template "nav" . }}

<div class="flex flex-col gap-8">
    <div class="flex flex-col gap-4 text-right">
        <h1 class="text-3xl font-bold text-gray-900">deezer accounts</h1>
        <p class="text-gray-500">manage official deezer subscriber accounts via arl for direct lossless flac playback and rotation</p>
    </div>

    <!-- Lossless Notice Banner -->
    <div class="p-4 border shadow-sm bg-purple-100/60 border-purple-500/30 flex items-center gap-x-3 w-full">
        <span class="text-purple-700 w-6">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"/></svg>
        </span>
        <div class="text-xs text-purple-900">
            <strong>Stream Lossless FLAC &amp; Rotación de Cuentas: Activo ✅</strong> — Las cuentas con suscripción HiFi/Premium proporcionan audio en calidad original FLAC (16-bit / 44.1kHz). Substream rota automáticamente entre todas las cuentas activas para balancear la carga y garantizar disponibilidad continua.
        </div>
    </div>

    <!-- Configured Accounts Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </span>
            <span class="text-gray-900 font-bold">configured accounts</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">active deezer accounts automatically rotated for lossless stream resolution</div>
        <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
            <div class="flex flex-col divide-y divide-gray-200">
                {{ range .DeezerAccounts }}
                <div class="flex items-center justify-between py-3">
                    <div class="flex items-center gap-2">
                        <form action="{{ path "/admin/deezer_delete_account_do" }}" method="POST" onsubmit="return confirm('remove this account?')">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="submit" value="delete" class="text-rose-600 hover:text-rose-700 cursor-pointer text-xs font-bold px-1.5 py-1">
                        </form>
                        <form action="{{ path "/admin/deezer_refresh_account_do" }}" method="POST">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="submit" value="recheck" class="text-blue-600 hover:text-blue-700 cursor-pointer text-xs font-bold px-1.5 py-1 bg-blue-50 hover:bg-blue-100 rounded">
                        </form>
                        <form action="{{ path "/admin/deezer_toggle_account_do" }}" method="POST">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="hidden" name="active" value="{{ if .IsActive }}false{{ else }}true{{ end }}">
                            <input type="submit" value="{{ if .IsActive }}disable{{ else }}enable{{ end }}" class="text-gray-600 hover:text-gray-800 cursor-pointer text-xs font-bold px-1.5 py-1 bg-gray-100 hover:bg-gray-200 rounded">
                        </form>
                    </div>
                    <div class="flex items-center gap-4">
                        {{ if .IsActive }}
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">active</span>
                        {{ else }}
                            <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded">inactive</span>
                        {{ end }}

                        {{ if ge .QualityTier 80 }}
                            <span class="text-xs font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2 py-0.5 rounded" title="Lossless FLAC 16-bit streams enabled">HiFi (FLAC Lossless)</span>
                        {{ else if ge .QualityTier 50 }}
                            <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded" title="High Quality 320kbps MP3">Premium (320k MP3)</span>
                        {{ else }}
                            <span class="text-xs font-bold text-gray-600 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded" title="Free tier (128kbps MP3)">Free (128k MP3)</span>
                        {{ end }}

                        <div class="flex flex-col items-end">
                            <span class="font-bold text-gray-900">{{ .Username }}</span>
                            <span class="text-[11px] text-gray-500">User ID: {{ .UserID }}</span>
                            {{ if .LastError }}
                                <span class="text-[10px] text-rose-500 font-mono max-w-[300px] truncate" title="{{ .LastError }}">Error: {{ .LastError }}</span>
                            {{ end }}
                            <span class="text-[10px] text-gray-400">added {{ dateHuman .CreatedAt }}</span>
                        </div>
                    </div>
                </div>
                {{ else }}
                <div class="py-10 text-center text-gray-400 font-medium italic">
                    no deezer accounts configured yet. add an account via ARL token below.
                </div>
                {{ end }}
            </div>
        </div>
    </div>

    <!-- Add Account via ARL Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </span>
            <span class="text-gray-900 font-bold">add deezer account</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">
            paste your Deezer <code class="bg-gray-200 px-1 py-0.5 rounded font-mono text-xs">arl</code> session cookie from your browser.
            <div class="mt-2 text-xs text-gray-600 bg-gray-100 p-2 rounded border border-gray-200">
                💡 <strong>How to get your ARL cookie:</strong><br>
                1. Open <a href="https://www.deezer.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline">deezer.com</a> and log in to your account.<br>
                2. Press <kbd class="px-1 bg-white border rounded">F12</kbd> (Developer Tools) &rarr; Go to the <strong>Application</strong> tab (or <strong>Storage</strong> in Firefox).<br>
                3. Under <strong>Cookies</strong>, select <code class="font-mono">https://www.deezer.com</code>.<br>
                4. Find the cookie named <code class="font-mono font-bold">arl</code> and copy its value.
            </div>
        </div>
        <form action="{{ path "/admin/deezer_add_account_do" }}" method="POST" class="mt-4 max-w-[700px] ml-auto space-y-4 text-right">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <div class="flex flex-col gap-1 items-end">
                <label for="deezer_arl" class="text-xs font-bold text-gray-700">ARL token</label>
                <input id="deezer_arl" type="text" name="arl" placeholder="c0ffee1234567890abcdef0123456789..." class="w-full border border-gray-300 px-3 py-2 text-sm rounded bg-white font-mono text-left" required autocomplete="off">
            </div>
            <div>
                <input type="submit" value="add account" class="bg-purple-700 hover:bg-purple-800 text-white font-bold px-6 py-2 rounded cursor-pointer text-sm transition-colors shadow">
            </div>
        </form>
    </div>
</div>

{{ template "foot" . }}
