{{ template "head" . }}
{{ template "nav" . }}

<div class="flex flex-col gap-8">
    <div class="flex flex-col gap-4 text-right">
        <h1 class="text-3xl font-bold text-gray-900">qobuz accounts</h1>
        <p class="text-gray-500">manage official qobuz subscriber accounts via user_auth_token for direct hi-res 24-bit flac streaming and rotation</p>
    </div>

    <!-- Hi-Res Notice Banner -->
    <div class="p-4 border shadow-sm bg-sky-100/60 border-sky-500/30 flex items-center gap-x-3 w-full">
        <span class="text-sky-700 w-6">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z"/></svg>
        </span>
        <div class="text-xs text-sky-900">
            <strong>Stream Hi-Res Studio Master (24-bit / up to 192kHz) &amp; Rotación de Cuentas: Activo ✅</strong> — Las cuentas con suscripción Studio/Sublime proporcionan audio en máxima resolución original FLAC directamente desde la red de entrega de Qobuz. Substream rota automáticamente entre todas las cuentas activas para balancear la carga y asegurar disponibilidad continua.
        </div>
    </div>

    <!-- Configured Accounts Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </span>
            <span class="text-gray-900 font-bold">configured accounts</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">active qobuz accounts automatically rotated for hi-res stream resolution</div>
        <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
            <div class="flex flex-col divide-y divide-gray-200">
                {{ range .QobuzAccounts }}
                <div class="flex items-center justify-between py-3">
                    <div class="flex items-center gap-2">
                        <form action="{{ path "/admin/qobuz_delete_account_do" }}" method="POST" onsubmit="return confirm('remove this account?')">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="submit" value="delete" class="text-rose-600 hover:text-rose-700 cursor-pointer text-xs font-bold px-1.5 py-1">
                        </form>
                        <form action="{{ path "/admin/qobuz_refresh_account_do" }}" method="POST">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="submit" value="recheck" class="text-sky-600 hover:text-sky-700 cursor-pointer text-xs font-bold px-1.5 py-1 bg-sky-50 hover:bg-sky-100 rounded">
                        </form>
                        <form action="{{ path "/admin/qobuz_toggle_account_do" }}" method="POST">
                            <input type="hidden" name="csrf_token" value="{{ $.CSRFToken }}">
                            <input type="hidden" name="id" value="{{ .ID }}">
                            <input type="hidden" name="active" value="{{ if .IsActive }}false{{ else }}true{{ end }}">
                            <input type="submit" value="{{ if .IsActive }}disable{{ else }}enable{{ end }}" class="text-gray-600 hover:text-gray-800 cursor-pointer text-xs font-bold px-1.5 py-1 bg-gray-100 hover:bg-gray-200 rounded">
                        </form>
                    </div>
                    <div class="flex items-center gap-4">
                        {{ if .IsActive }}
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">active</span>
                        {{ else }}
                            <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded">inactive</span>
                        {{ end }}

                        {{ if ge .QualityTier 90 }}
                            <span class="text-xs font-bold text-sky-800 bg-sky-50 border border-sky-300 px-2 py-0.5 rounded" title="Studio Hi-Res FLAC (up to 24-bit / 192kHz) enabled">Studio Hi-Res (24-bit FLAC)</span>
                        {{ else if ge .QualityTier 80 }}
                            <span class="text-xs font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2 py-0.5 rounded" title="Lossless FLAC 16-bit streams enabled">HiFi (16-bit FLAC)</span>
                        {{ else if ge .QualityTier 50 }}
                            <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded" title="High Quality 320kbps MP3">Premium (320k MP3)</span>
                        {{ else }}
                            <span class="text-xs font-bold text-gray-600 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded" title="Free tier">Free</span>
                        {{ end }}

                        <div class="flex flex-col items-end">
                            <span class="font-bold text-gray-900">{{ .Username }}</span>
                            <span class="text-[11px] text-gray-500">User ID: {{ .UserID }}</span>
                            {{ if .LastError }}
                                <span class="text-[10px] text-rose-500 font-mono max-w-[300px] truncate" title="{{ .LastError }}">Error: {{ .LastError }}</span>
                            {{ end }}
                            <span class="text-[10px] text-gray-400">added {{ dateHuman .CreatedAt }}</span>
                        </div>
                    </div>
                </div>
                {{ else }}
                <div class="py-10 text-center text-gray-400 font-medium italic">
                    no qobuz accounts configured yet. add an account via user_auth_token below.
                </div>
                {{ end }}
            </div>
        </div>
    </div>

    <!-- Add Account Block -->
    <div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
        <div class="inline-flex items-center gap-x-3">
            <span class="text-gray-500/80 w-4">
                <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </span>
            <span class="text-gray-900 font-bold">add qobuz account</span>
        </div>
        <hr class="bg-gray-900/30 my-1" />
        <div class="font-medium text-gray-500 max-w-[700px]">
            paste your Qobuz <code class="bg-gray-200 px-1 py-0.5 rounded font-mono text-xs">user_auth_token</code> from your web browser or client session.
            <div class="mt-2 text-xs text-gray-600 bg-gray-100 p-2 rounded border border-gray-200">
                💡 <strong>How to get your user_auth_token:</strong><br>
                1. Open <a href="https://play.qobuz.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline">play.qobuz.com</a> and log in to your account.<br>
                2. Press <kbd class="px-1 bg-white border rounded">F12</kbd> (Developer Tools) &rarr; Go to <strong>Application</strong> (or <strong>Storage</strong> in Firefox).<br>
                3. Under <strong>Local Storage</strong> or <strong>Cookies</strong> for play.qobuz.com, look for <code class="font-mono font-bold">user_auth_token</code> (or inspect network calls to <code class="font-mono">api.json/0.2/user/login</code>).<br>
                4. Copy the token value and paste it below.
            </div>
        </div>
        <form action="{{ path "/admin/qobuz_add_account_do" }}" method="POST" class="mt-4 max-w-[700px] ml-auto space-y-4 text-right">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <div class="flex flex-col gap-1 items-end">
                <label for="qobuz_token" class="text-xs font-bold text-gray-700">User Auth Token</label>
                <input id="qobuz_token" type="text" name="token" placeholder="s_token_abcdef1234567890..." class="w-full border border-gray-300 px-3 py-2 text-sm rounded bg-white font-mono text-left" required autocomplete="off">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col gap-1 items-end">
                    <label for="qobuz_app_id" class="text-xs font-semibold text-gray-500">App ID (optional)</label>
                    <input id="qobuz_app_id" type="text" name="app_id" placeholder="default / system" class="w-full border border-gray-200 px-3 py-1.5 text-xs rounded bg-white font-mono text-left" autocomplete="off">
                </div>
                <div class="flex flex-col gap-1 items-end">
                    <label for="qobuz_app_secret" class="text-xs font-semibold text-gray-500">App Secret (optional)</label>
                    <input id="qobuz_app_secret" type="password" name="app_secret" placeholder="default / system" class="w-full border border-gray-200 px-3 py-1.5 text-xs rounded bg-white font-mono text-left" autocomplete="off">
                </div>
            </div>
            <div>
                <input type="submit" value="add account" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-6 py-2 rounded cursor-pointer text-sm transition-colors shadow">
            </div>
        </form>
    </div>
</div>

{{ template "foot" . }}
