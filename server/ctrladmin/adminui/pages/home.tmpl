{{ template "head" . }}
{{ template "nav" . }}

<!-- Stats Block -->
<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M302 240V16.6c0-9 7-16.6 16-16.6C441.7 0 542 100.3 542 224c0 9-7.6 16-16.6 16H302zM30 272C30 150.7 120.1 50.3 237 34.3c9.2-1.3 17 6.1 17 15.4V288L410.5 444.5c6.7 6.7 6.2 17.7-1.5 23.1C369.8 495.6 321.8 512 270 512C137.5 512 30 404.6 30 272zm526.4 16c9.3 0 16.6 7.8 15.4 17c-7.7 55.9-34.6 105.6-73.9 142.3c-6 5.6-15.4 5.2-21.2-.7L318 288H556.4z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">stats</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">saved metrics in the local database</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <div class="grid grid-cols-[auto_min-content] gap-2 gap-x-5 text-right">
            <div class="text-gray-500">albums</div>
            <div class="font-bold">{{ .Stats.Albums }}</div>
            <div class="text-gray-500">artists</div>
            <div class="font-bold">{{ .Stats.Artists }}</div>
            <div class="text-gray-500">tracks</div>
            <div class="font-bold">{{ .Stats.Tracks }}</div>
        </div>
    </div>
</div>

<!-- User Management Block -->
<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M144 0a80 80 0 1 1 0 160A80 80 0 1 1 144 0zM512 0a80 80 0 1 1 0 160A80 80 0 1 1 512 0zM0 298.7C0 239.8 47.8 192 106.7 192h42.7c15.9 0 31 3.5 44.6 9.7c-1.3 7.2-1.9 14.7-1.9 22.3c0 38.2 16.8 72.5 43.3 96c-.2 0-.4 0-.7 0H21.3C9.6 320 0 310.4 0 298.7zM405.3 320c-.2 0-.4 0-.7 0c26.6-23.5 43.3-57.8 43.3-96c0-7.6-.7-15-1.9-22.3c13.6-6.3 28.7-9.7 44.6-9.7h42.7C592.2 192 640 239.8 640 298.7c0 11.8-9.6 21.3-21.3 21.3H405.3zM224 224a96 96 0 1 1 192 0 96 96 0 1 1 -192 0zM128 485.3C128 411.7 187.7 352 261.3 352H378.7C452.3 352 512 411.7 512 485.3c0 14.7-11.9 26.7-26.7 26.7H154.7c-14.7 0-26.7-11.9-26.7-26.7z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">user management</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">manage user accounts for subsonic api and web interface access</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <div class="grid grid-cols-[repeat(3,auto)_max-content] md:grid-cols-[auto_repeat(5,min-content)] gap-2 gap-x-5 items-center text-right">
            {{ range $user := .AllUsers }}
                <div class="col-span-3 md:col-auto ellipsis">{{ $user.Name }}</div>
                <div class="text-gray-500 whitespace-nowrap">{{ $user.CreatedAt | date }}</div>
                <a class="text-blue-500" href="{{ printf "/admin/change_username?user=%s" $user.Name | path }}">username&#8230;</a>
                <a class="text-blue-500" href="{{ printf "/admin/change_password?user=%s" $user.Name | path }}">password&#8230;</a>
                <a class="text-blue-500" href="{{ printf "/admin/change_avatar?user=%s" $user.Name | path }}">avatar&#8230;</a>
                {{ if $user.IsAdmin }}
                    <div class="text-gray-500">delete<span class="hidden md:inline">&#8230;</span></div>
                {{ else }}
                    <a class="text-blue-500" href="{{ printf "/admin/delete_user?user=%s" $user.Name | path }}">delete&#8230;</a>
                {{ end }}
            {{ end }}
            {{ if .User.IsAdmin }}
                <div class="col-span-full flex gap-8 justify-end pt-2 border-t border-gray-200 mt-2">
                    <a class="text-blue-500" href="{{ path "/admin/settings" }}">server settings&#8230;</a>
                    <span class="text-gray-300">|</span>
                    <a class="text-blue-500" href="{{ path "/admin/create_user" }}">create new user&#8230;</a>
                </div>
            {{ end }}
        </div>
    </div>
</div>

<!-- Last.fm Block -->
<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M225.8 367.1l-18.8-51s-30.5 34-76.2 34c-40.5 0-69.2-35.2-69.2-91.5 0-72.1 36.4-97.9 72.1-97.9 66.5 0 74.8 53.3 100.9 134.9 18.8 56.9 54 102.6 155.4 102.6 72.7 0 122-22.3 122-80.9 0-72.9-62.7-80.6-115-92.1-25.8-5.9-33.4-16.4-33.4-34 0-19.9 15.8-31.7 41.6-31.7 28.2 0 43.4 10.6 45.7 35.8l58.6-7c-4.7-52.8-41.1-74.5-100.9-74.5-52.8 0-104.4 19.9-104.4 83.9 0 39.9 19.4 65.1 68 76.8 44.9 10.6 79.8 13.8 79.8 45.7 0 21.7-21.1 30.5-61 30.5-59.2 0-83.9-31.1-97.9-73.9-32-96.8-43.6-163-161.3-163C45.7 113.8 0 168.3 0 261c0 89.1 45.7 137.2 127.9 137.2 66.2 0 97.9-31.1 97.9-31.1z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">last.fm</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">scrobble to last.fm on a per user basis</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <div class="flex flex-col gap-2 items-end">
            {{ if .User.LastfmSession }}
                <p class="text-gray-500">current status <span class="font-bold text-green-500">linked</span></p>
                <form class="contents" action="{{ path "/admin/unlink_lastfm_do" }}" method="post">
                    <input type="submit" value="unlink">
                </form>
            {{ else }}
                <p class="text-gray-500">current status <span class="font-bold text-red-400">unlinked</span></p>
                <p class="text-xs text-gray-400">link via client app</p>
            {{ end }}
        </div>
    </div>
</div>

<!-- ListenBrainz Block -->
<div class="border-b-2 border-r-2 border-gray-300/80 bg-gray-50 p-4">
    <div class="inline-flex items-center gap-x-3">
        <span class="text-gray-500/80 w-4">
            <svg class="fill-current aspect-square" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M184 0c30.9 0 56 25.1 56 56V456c0 30.9-25.1 56-56 56c-28.9 0-52.7-21.9-55.7-50.1c-5.2 1.4-10.7 2.1-16.3 2.1c-35.3 0-64-28.7-64-64c0-7.4 1.3-14.6 3.6-21.2C21.4 367.4 0 338.2 0 304c0-31.9 18.7-59.5 45.8-72.3C37.1 220.8 32 207 32 192c0-30.7 21.6-56.3 50.4-62.6C80.8 123.9 80 118 80 112c0-29.9 20.6-55.1 48.3-62.1C131.3 21.9 155.1 0 184 0zM328 0c28.9 0 52.6 21.9 55.7 49.9c27.8 7 48.3 32.1 48.3 62.1c0 6-.8 11.9-2.4 17.4c28.8 6.2 50.4 31.9 50.4 62.6c0 15-5.1 28.8-13.8 39.7C493.3 244.5 512 272.1 512 304c0 34.2-21.4 63.4-51.6 74.8c2.3 6.6 3.6 13.8 3.6 21.2c0 35.3-28.7 64-64 64c-5.6 0-11.1-.7-16.3-2.1c-3 28.2-26.8 50.1-55.7 50.1c-30.9 0-56-25.1-56-56V56c0-30.9 25.1-56 56-56z"/></svg>
        </span>
        <span class="text-gray-900 font-bold">listenbrainz</span>
    </div>
    <hr class="bg-gray-900/30 my-1" />
    <div class="font-medium text-gray-500 max-w-[700px]">scrobble to listenbrainz and compatible sites on a per user basis</div>
    <div class="mt-3 max-w-[700px] ml-auto space-y-2 text-right">
        <div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-center justify-items-end">
        {{ if .User.ListenbrainzToken }}
            <p class="text-gray-500 col-span-full">current status <span class="font-bold text-green-500">linked</span></p>
            <form class="contents" action="{{ path "/admin/unlink_listenbrainz_do" }}" method="post">
                <input class="col-span-full" type="submit" value="unlink">
            </form>
        {{ else }}
            <p class="text-gray-500 col-span-full">current status <span class="font-bold text-red-400">unlinked</span></p>
            <form class="contents" action="{{ path "/admin/link_listenbrainz_do" }}" method="post">
            <input type="text" name="url" placeholder="server addr" value="{{ default .DefaultListenBrainzURL .User.ListenbrainzUrl }}">
            <input type="text" name="token" placeholder="api key" value="{{ .User.ListenbrainzToken }}">
            <input type="submit" value="update">
            </form>
        {{ end }}
        </div>
    </div>
</div>

{{ template "foot" . }}
